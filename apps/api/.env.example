# ---- Server
PORT=4000
NODE_ENV=development
WEB_URL=http://localhost:3000

# ---- Database (docker compose up -d db)
DATABASE_URL=postgresql://amerivo:amerivo@localhost:5432/amerivo

# ---- Auth (Clerk)
CLERK_SECRET_KEY=sk_test_xxx
# Local only: accept "x-dev-user: <clerkId>" instead of a Clerk token. Never enable in production.
DEV_AUTH=1

# ---- Payments (Stripe Connect, test mode)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Video (Daily.co)
DAILY_API_KEY=xxx
DAILY_DOMAIN=amerivo.daily.co
# Minutes before a lesson when the classroom opens (default 5, max 15)
CLASSROOM_EARLY_MIN=5

# ---- Notifications
RESEND_API_KEY=re_xxx
EMAIL_FROM="Amerivo English <contact@amerivoenglish.com>"
# Public support address: receives contact-form copies, Reply-To of e-mails sent to customers
SUPPORT_EMAIL=contact@amerivoenglish.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
